{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_GEMINI_API_KEY": "${EXPO_PUBLIC_GEMINI_API_KEY}",
        "EXPO_PUBLIC_SHEETS_WEBHOOK_URL": "${EXPO_PUBLIC_SHEETS_WEBHOOK_URL}",
        "EXPO_PUBLIC_OPENROUTER_API_KEY": "${EXPO_PUBLIC_OPENROUTER_API_KEY}"
      }
    },
    "apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_GEMINI_API_KEY": "${EXPO_PUBLIC_GEMINI_API_KEY}",
        "EXPO_PUBLIC_SHEETS_WEBHOOK_URL": "${EXPO_PUBLIC_SHEETS_WEBHOOK_URL}",
        "EXPO_PUBLIC_OPENROUTER_API_KEY": "${EXPO_PUBLIC_OPENROUTER_API_KEY}"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_GEMINI_API_KEY": "${EXPO_PUBLIC_GEMINI_API_KEY}",
        "EXPO_PUBLIC_SHEETS_WEBHOOK_URL": "${EXPO_PUBLIC_SHEETS_WEBHOOK_URL}",
        "EXPO_PUBLIC_OPENROUTER_API_KEY": "${EXPO_PUBLIC_OPENROUTER_API_KEY}"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
